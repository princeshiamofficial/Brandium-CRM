# Disable OpenLiteSpeed / LiteSpeed caching for real-time CRM
<IfModule LiteSpeed>
    CacheLookup off
    CacheEngine off
</IfModule>

<IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Direct high-speed static asset serving from .output/public/
    RewriteCond %{DOCUMENT_ROOT}/.output/public%{REQUEST_URI} -f
    RewriteRule ^(.*)$ .output/public/$1 [L]

    # 2. Reverse proxy all dynamic SSR routes and API requests to PM2 on port 3005
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.*)$ http://127.0.0.1:3005/$1 [P,L]
</IfModule>

